@page
@model Riviana.Pages.productPage
@{
}
<!--begin::App Content Header-->
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-semibold text-primary">Product</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Product</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div id="printArea" class="container mt-4 form-section">
        <div class="container-fluid mt-4">
            <div class="border rounded p-4 bg-white shadow-lg form-section animate__animated animate__fadeIn">

                <!-- Header Info -->
                <table class="table table-bordered table-sm align-middle small mb-3 w-100">
                    <tbody>
                        <tr>
                            <th style="width:15%;">Product Name:</th>
                            <td style="width:35%;">
                                <select class="form-select form-select-sm">
                                    <option value="">Select</option>
                                    <option selected>Roza Artichoke Dip</option>
                                    <option>Roza Eggplant Dip</option>
                                    <option>Roza Capsicum Dip</option>
                                </select>
                            </td>
                            <th style="width:10%;">Date:</th>
                            <td style="width:20%;">
                                <input type="date" class="form-control form-control-sm">
                            </td>
                        </tr>
                        <tr>
                            <th>Mixer:</th>
                            <td><input type="text" class="form-control form-control-sm"></td>
                            <th>No. of Loads / Batch:</th>
                            <td><input type="text" class="form-control form-control-sm"></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Ingredient Table -->
                <div class="table-responsive mb-3">
                    <table class="table table-bordered table-sm text-center align-middle mb-0 w-100">
                        <thead class="table-primary">
                            <tr>
                                <th>Ingredient</th>
                                <th>SML Mixer Qty</th>
                                <th>Batch Code</th>
                                <th>Condition Check<br><small>(Pass / Fail)</small></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Artichoke Hearts Whole</td>
                                <td>5.5 Kg</td>
                                <td><input type="text" class="form-control form-control-sm"></td>
                                <td>
                                    <select class="form-select form-select-sm">
                                        <option>Select</option>
                                        <option>Pass</option>
                                        <option>Fail</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td>Fresh Dill</td>
                                <td>199 G</td>
                                <td><input type="text" class="form-control form-control-sm"></td>
                                <td><select class="form-select form-select-sm"><option>Select</option><option>Pass</option><option>Fail</option></select></td>
                            </tr>
                            <tr>
                                <td>Garlic - Smooth</td>
                                <td>1.7 Kg</td>
                                <td><input type="text" class="form-control form-control-sm"></td>
                                <td><select class="form-select form-select-sm"><option>Select</option><option>Pass</option><option>Fail</option></select></td>
                            </tr>
                            <tr>
                                <td>Honey</td>
                                <td>1.7 Kg</td>
                                <td><input type="text" class="form-control form-control-sm"></td>
                                <td><select class="form-select form-select-sm"><option>Select</option><option>Pass</option><option>Fail</option></select></td>
                            </tr>
                            <tr>
                                <td>Lemon Juice (Frozen)</td>
                                <td>75 G</td>
                                <td><input type="text" class="form-control form-control-sm"></td>
                                <td><select class="form-select form-select-sm"><option>Select</option><option>Pass</option><option>Fail</option></select></td>
                            </tr>
                            <tr>
                                <td>Neufchatel Cheese</td>
                                <td>19.5 Kg</td>
                                <td><input type="text" class="form-control form-control-sm"></td>
                                <td><select class="form-select form-select-sm"><option>Select</option><option>Pass</option><option>Fail</option></select></td>
                            </tr>
                            <tr>
                                <td>White Vinegar 10%</td>
                                <td>1.35 Kg</td>
                                <td><input type="text" class="form-control form-control-sm"></td>
                                <td><select class="form-select form-select-sm"><option>Select</option><option>Pass</option><option>Fail</option></select></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <p class="small mb-2"><strong>Allergen Check:</strong> SWAB IF USED FISH PRODUCTS PRIOR TO MIXING</p>

                <!-- Preparation Method -->
                <div class="mb-3 small">
                    <strong>Preparation Method</strong>
                    <ol class="mt-1">
                        <li>Weigh all ingredients.</li>
                        <li>Add everything except half of cream cheese and mix for 2 min 30 seconds.</li>
                        <li>Add half of cream cheese and mix for 2 min 30 seconds.</li>
                        <li>Perform QA checks to ensure product is in spec.</li>
                    </ol>
                </div>

                <!-- QA Check -->
                <div class="small mb-3">
                    <strong>QA Check:</strong> Target pH range Final Product: <strong>&lt; 4.2</strong>
                </div>

                <!-- pH Test Table -->
                <div class="table-responsive mb-3">
                    <table class="table table-bordered table-sm text-center align-middle w-100">
                        <thead class="table-primary">
                            <tr>
                                <th>Start Time</th>
                                <th>Middle Time</th>
                                <th>End Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input type="time" class="form-control form-control-sm"><br>pH: <input type="text" class="form-control form-control-sm d-inline-block" style="width:80px;"></td>
                                <td><input type="time" class="form-control form-control-sm"><br>pH: <input type="text" class="form-control form-control-sm d-inline-block" style="width:80px;"></td>
                                <td><input type="time" class="form-control form-control-sm"><br>pH: <input type="text" class="form-control form-control-sm d-inline-block" style="width:80px;"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Deviations -->
                <div class="small mb-3">
                    <strong>Deviations</strong>
                    <table class="table table-bordered table-sm mt-1 align-middle w-100">
                        <thead class="table-primary text-center">
                            <tr>
                                <th style="width:15%">Time</th>
                                <th>Deviation details</th>
                                <th style="width:20%">Approved by</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input type="time" class="form-control form-control-sm"></td>
                                <td><input type="text" class="form-control form-control-sm"></td>
                                <td>
                                    <select class="form-select form-select-sm">
                                        <option>Raj Pradhan</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td><input type="time" class="form-control form-control-sm"></td>
                                <td><input type="text" class="form-control form-control-sm"></td>
                                <td>
                                    <select class="form-select form-select-sm">
                                        <option>Raj Pradhan</option>
                                    </select>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Footer -->
                <div class="d-flex justify-content-between align-items-center mt-4 small">
                    <p class="mb-0">
                        <strong>Prepared By:</strong>
                        <select class="form-select form-select-sm d-inline-block" style="width:180px;">
                            <option>Dishani Weragama</option>
                        </select>
                    </p>
                    <p class="mb-0">
                        <strong>Approved By:</strong>
                        <select class="form-select form-select-sm d-inline-block" style="width:180px;">
                            <option>Raj Pradhan</option>
                        </select>
                    </p>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success btn-sm px-4" id="saveBtn">💾 Save Product</button>
                    <button class="btn btn-primary  btn-sm px-4" onclick="printForm()">🖨️ Print Form</button>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        document.getElementById('saveBtn').addEventListener('click', function(e) {
            e.preventDefault();
            alert('✅ Product saved successfully!');
        });

        function printForm() {
            window.print();
        }
    </script>
}



