@page
@model Riviana.Pages.Mixing.Reports.IndexModel
@{
    ViewData["Title"] = "Reports Dashboard";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Reports Dashboard</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="/Index">Home</a></li>
                    <li class="breadcrumb-item">Mixing</li>
                    <li class="breadcrumb-item active" aria-current="page">Reports</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <!-- Stat Widgets -->
        <div class="row g-4 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm overflow-hidden h-100">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                            <i class="bi bi-clipboard-check fs-3"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-bold">128</h3>
                            <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem">Total Checks</small>
                        </div>
                    </div>
                    <div class="progress" style="height: 3px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 75%"></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm overflow-hidden h-100">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 me-3">
                             <i class="bi bi-exclamation-triangle fs-3"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-bold">3</h3>
                            <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem">Issues Found</small>
                        </div>
                    </div>
                    <div class="progress" style="height: 3px;">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: 15%"></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm overflow-hidden h-100">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                            <i class="bi bi-hourglass-split fs-3"></i>
                        </div>
                         <div>
                            <h3 class="mb-0 fw-bold">12</h3>
                            <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem">Pending</small>
                        </div>
                    </div>
                    <div class="progress" style="height: 3px;">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: 45%"></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                 <div class="card border-0 shadow-sm overflow-hidden h-100">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                            <i class="bi bi-graph-up-arrow fs-3"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-bold">98%</h3>
                             <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem">Compliance</small>
                        </div>
                    </div>
                    <div class="progress" style="height: 3px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 98%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h5 class="card-title fw-bold">Weekly Compliance Trend</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div id="complianceChart" style="min-height: 300px;"></div>
                    </div>
                </div>
            </div>
             <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                     <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h5 class="card-title fw-bold">Issue Breakdown</h5>
                    </div>
                    <div class="card-body px-4 pb-4 d-flex align-items-center justify-content-center">
                         <div id="issueChart" style="min-height: 300px; width: 100%;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reports Links -->
        <h5 class="fw-bold text-secondary mb-3 mt-4">Available Reports</h5>
        <div class="row g-4">
            
            <!-- Pre-Start Checks -->
            <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="card h-100 card-hover shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="icon-box mb-3 mx-auto bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                            <i class="bi bi-clipboard-check fs-2"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-2">Pre-Start Checks</h5>
                        <p class="card-text text-muted small mb-4">View daily pre-start checklist logs and verified statuses.</p>
                        <a href="/Mixing/Reports/PreStartLog" class="btn btn-outline-primary w-100 stretched-link">View Report</a>
                    </div>
                </div>
            </div>

            <!-- Change Over -->
            <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="card h-100 card-hover shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="icon-box mb-3 mx-auto bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                            <i class="bi bi-arrow-repeat fs-2"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-2">Change Over</h5>
                        <p class="card-text text-muted small mb-4">Track product changeover details, timings, and approvals.</p>
                        <a href="/Mixing/Reports/ChangeOverLog" class="btn btn-outline-warning w-100 stretched-link">View Report</a>
                    </div>
                </div>
            </div>

             <!-- Tools Register -->
            <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="card h-100 card-hover shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="icon-box mb-3 mx-auto bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                            <i class="bi bi-tools fs-2"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-2">Tools Register</h5>
                        <p class="card-text text-muted small mb-4">Monitor tool usage, returns, and cleaning status per shift.</p>
                        <a href="/Mixing/Reports/ToolsRegisterLog" class="btn btn-outline-success w-100 stretched-link">View Report</a>
                    </div>
                </div>
            </div>

            <!-- pH Checks & Calibration -->
            <div class="col-md-6 col-lg-4 col-xl-3">
                 <div class="card h-100 card-hover shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="icon-box mb-3 mx-auto bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                            <i class="bi bi-droplet-half fs-2"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-2">pH Logs</h5>
                        <p class="card-text text-muted small mb-4">Analyze pH value recordings and daily meter calibrations.</p>
                        <a href="/Mixing/Reports/PhLog" class="btn btn-outline-info w-100 stretched-link">View Report</a>
                    </div>
                </div>
            </div>

            <!-- Cleaning -->
            <div class="col-md-6 col-lg-4 col-xl-3">
                 <div class="card h-100 card-hover shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="icon-box mb-3 mx-auto bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                            <i class="bi bi-stars fs-2"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-2">Cleaning Logs</h5>
                        <p class="card-text text-muted small mb-4">Review daily, weekly, and monthly cleaning verifications.</p>
                        <a href="/Mixing/Reports/CleaningLog" class="btn btn-outline-danger w-100 stretched-link">View Report</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Weekly Compliance Trend Chart
            var complianceOptions = {
                series: [{
                    name: 'Compliance Rate',
                    data: [92, 95, 98, 94, 99, 97, 98]
                }],
                chart: {
                    type: 'area',
                    height: 350,
                    toolbar: { show: false },
                    zoom: { enabled: false }
                },
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: 2 },
                 colors: ['#0d6efd'],
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.4,
                        opacityTo: 0.1,
                        stops: [0, 90, 100]
                    }
                },
                xaxis: {
                    categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                     axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                 yaxis: {
                    max: 100,
                    min: 80
                },
                tooltip: { y: { formatter: function (val) { return val + "%" } } }
            };
            var chart1 = new ApexCharts(document.querySelector("#complianceChart"), complianceOptions);
            chart1.render();

            // Issue Breakdown Chart
            var issueOptions = {
                series: [44, 55, 13, 43],
                chart: { width: 380, type: 'donut' },
                labels: ['Pre-Start', 'Change Over', 'pH Checks', 'Cleaning'],
                colors: ['#0d6efd', '#ffc107', '#0dcaf0', '#dc3545'],
                plotOptions: {
                    pie: {
                        donut: {
                             size: '65%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Total Issues',
                                    formatter: function (w) {
                                        return w.globals.seriesTotals.reduce((a, b) => { return a + b }, 0)
                                    }
                                }
                            }
                        }
                    }
                },
                dataLabels: { enabled: false },
                legend: { position: 'bottom' }
            };
            var chart2 = new ApexCharts(document.querySelector("#issueChart"), issueOptions);
            chart2.render();
        });
    </script>
}
</div>

<style>
    .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>
