@page
@model Riviana.Pages.Mixing.Reports.PreStartLogModel
@{
    ViewData["Title"] = "Pre-Start Checks Report";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Pre-Start Checks Report</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="/Index">Home</a></li>
                    <li class="breadcrumb-item">Mixing</li>
                    <li class="breadcrumb-item"><a href="/Mixing/Reports/Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Pre-Start Checks</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        
        <!-- Filters & Actions -->
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label for="FilterDate" class="form-label fw-bold small text-muted">Filter by Date</label>
                        <input type="date" class="form-control" id="FilterDate" name="FilterDate" value="@Model.FilterDate?.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter me-1"></i> Apply Filter</button>
                    </div>
                     <div class="col-md-6 text-md-end">
                         <div class="btn-group">
                            <button type="button" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-excel me-1"></i> Export CSV</button>
                            <button type="button" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-pdf me-1"></i> Export PDF</button>
                         </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Data Grid -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold text-secondary">Historical Records</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Time Started</th>
                            <th>Team Leader</th>
                            <th>Overall Status</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Logs)
                        {
                            <tr>
                                <td>@item.Date.ToShortDateString()</td>
                                <td>@item.Time</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-secondary bg-opacity-10 text-secondary me-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @item.TeamLeader.Substring(0, 1)
                                        </div>
                                        @item.TeamLeader
                                    </div>
                                </td>
                                <td>
                                    @if(item.OverallStatus == "Pass")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-3 px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i> Passed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-3 px-2 py-1"><i class="bi bi-exclamation-octagon-fill me-1"></i> Attention</span>
                                    }
                                </td>
                                <td class="text-truncate" style="max-width: 200px;" title="@item.Notes">@item.Notes</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-light border" data-bs-toggle="modal" data-bs-target="#detailsModal" 
                                            onclick="loadDetails('@item.Date.ToShortDateString()', '@item.TeamLeader', '@item.OverallStatus')">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (Model.Logs.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    No records found for the selected filter.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
             <div class="card-footer bg-white border-top-0 py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-end mb-0">
                        <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><a class="page-link" href="#">Next</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Pre-Start Inspection Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-4">
                <div class="row mb-4">
                    <div class="col-sm-4">
                        <small class="text-muted d-block uppercase mb-1">Date</small>
                        <strong id="modalDate" class="fs-5"></strong>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block uppercase mb-1">Inspector</small>
                        <strong id="modalLeader"></strong>
                    </div>
                     <div class="col-sm-4">
                        <small class="text-muted d-block uppercase mb-1">Status</small>
                        <span id="modalStatus" class="badge bg-success"></span>
                    </div>
                </div>

                <div class="bg-light p-3 rounded mb-3">
                    <h6 class="fw-bold mb-3 border-bottom pb-2">Checklist Summary</h6>
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td class="w-50">Scales Accuracy</td>
                            <td class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Passed</td>
                        </tr>
                        <tr>
                            <td>Area Cleanliness</td>
                            <td class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Passed</td>
                        </tr>
                         <tr>
                            <td>Mixer Integrity</td>
                            <td class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Passed</td>
                        </tr>
                         <tr>
                            <td>Safety Guards</td>
                            <td class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Passed</td>
                        </tr>
                        <tr>
                            <td>Utensils Ready</td>
                            <td class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Passed</td>
                        </tr>
                    </table>
                </div>
                
                 <div class="bg-light p-3 rounded">
                     <h6 class="fw-bold mb-2">Notes</h6>
                     <p class="mb-0 text-muted small">Routine inspection completed. No issues found.</p>
                 </div>

            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary"><i class="bi bi-printer me-1"></i> Print</button>
            </div>
        </div>
    </div>
</div>

<script>
    function loadDetails(date, leader, status) {
        document.getElementById('modalDate').innerText = date;
        document.getElementById('modalLeader').innerText = leader;
        
        const badge = document.getElementById('modalStatus');
        badge.innerText = status;
        if(status === 'Pass') {
            badge.className = 'badge bg-success';
        } else {
            badge.className = 'badge bg-danger';
        }
    }
</script>
