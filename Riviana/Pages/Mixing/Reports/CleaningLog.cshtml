@page
@model Riviana.Pages.Mixing.Reports.CleaningLogModel
@{
    ViewData["Title"] = "Cleaning Logs Report";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Cleaning Logs Report</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="/Index">Home</a></li>
                    <li class="breadcrumb-item">Mixing</li>
                    <li class="breadcrumb-item"><a href="/Mixing/Reports/Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cleaning Logs</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <!-- Filters -->
         <div class="card mb-4 shadow-sm border-0">
             <div class="card-body">
                 <form method="get" class="row g-3 align-items-end">
                     <div class="col-md-3">
                         <label for="FilterDate" class="form-label fw-bold small text-muted">Filter by Date</label>
                         <input type="date" class="form-control" id="FilterDate" name="FilterDate" value="@Model.FilterDate?.ToString("yyyy-MM-dd")">
                     </div>
                     <div class="col-md-3">
                         <button type="submit" class="btn btn-danger text-white w-100"><i class="bi bi-filter me-1"></i> Apply Filter</button>
                     </div>
                      <div class="col-md-6 text-md-end">
                         <div class="btn-group">
                            <button type="button" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-excel me-1"></i> Export CSV</button>
                            <button type="button" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-pdf me-1"></i> Export PDF</button>
                         </div>
                    </div>
                 </form>
             </div>
         </div>

         <!-- Data Grid -->
         <div class="card shadow-sm border-0">
             <div class="card-header bg-white py-3">
                 <h5 class="card-title mb-0 fw-bold text-secondary">Cleaning Verification Records</h5>
             </div>
             <div class="table-responsive">
                 <table class="table table-hover align-middle mb-0">
                     <thead class="table-light">
                         <tr>
                             <th>Date</th>
                             <th>Equipment / Area</th>
                             <th>Frequency</th>
                             <th>Level</th>
                             <th>Operator</th>
                             <th class="text-end">Actions</th>
                         </tr>
                     </thead>
                     <tbody>
                         @foreach (var item in Model.Logs)
                         {
                             <tr>
                                 <td>@item.Date.ToShortDateString()</td>
                                 <td class="fw-bold">@item.Equipment</td>
                                 <td><span class="badge bg-light text-dark border rounded-3 px-2"><i class="bi bi-clock-history me-1"></i> @item.Frequency</span></td>
                                 <td>
                                     <span class="d-inline-flex align-items-center justify-content-center bg-secondary text-white rounded-circle" style="width: 24px; height: 24px; font-size: 0.8rem;">@item.Level</span>
                                 </td>
                                 <td>@item.Operator</td>
                                 <td class="text-end">
                                     <button class="btn btn-sm btn-light border" data-bs-toggle="modal" data-bs-target="#detailsModal"
                                         onclick="loadDetails('@item.Date.ToShortDateString()', '@item.Equipment', '@item.Frequency', '@item.Operator')">
                                         <i class="bi bi-eye"></i> View
                                     </button>
                                 </td>
                             </tr>
                         }
                     </tbody>
                 </table>
             </div>
         </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
             <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">Cleaning Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                     <div class="col-12 mb-3">
                        <small class="text-muted d-block">Equipment</small>
                        <strong id="modalEquipment" class="fs-5"></strong>
                    </div>
                    <div class="col-6 mb-3">
                        <small class="text-muted d-block">Date</small>
                        <strong id="modalDate"></strong>
                    </div>
                     <div class="col-6 mb-3">
                        <small class="text-muted d-block">Performed By</small>
                        <strong id="modalOperator"></strong>
                    </div>
                     <div class="col-6 mb-3">
                        <small class="text-muted d-block">Frequency</small>
                        <strong id="modalFrequency"></strong>
                    </div>
                </div>
                 <div class="alert alert-success d-flex align-items-center mt-2">
                     <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                     <div>
                         <strong>Verified</strong>
                         <div class="small">Equipment passed visual inspection.</div>
                     </div>
                 </div>
            </div>
             <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    function loadDetails(date, equipment, frequency, operator) {
        document.getElementById('modalDate').innerText = date;
        document.getElementById('modalEquipment').innerText = equipment;
        document.getElementById('modalFrequency').innerText = frequency;
        document.getElementById('modalOperator').innerText = operator;
    }
</script>
