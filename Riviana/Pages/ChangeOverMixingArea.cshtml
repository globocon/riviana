<script type="text/javascript">

    function saveme(){
        var r = $('#inpsign').val();
        alert("Saved: " + r);
    };

    function printReport() {
        var container = document.getElementById('printableArea');
        
        // Sync current values and selected options into the DOM attributes so innerHTML captures them
        var inputs = container.querySelectorAll('input');
        inputs.forEach(function(input) {
            input.setAttribute('value', input.value);
        });
        
        var selects = container.querySelectorAll('select');
        selects.forEach(function(select) {
            var options = select.querySelectorAll('option');
            options.forEach(function(option) {
                if (option.selected) {
                    option.setAttribute('selected', 'selected');
                } else {
                    option.removeAttribute('selected');
                }
            });
        });

        var printContents = container.innerHTML;
        
        // Open a new window
        var printWindow = window.open('', '_blank', 'height=600,width=800');
        
        printWindow.document.write('<html><head><title>Print Report</title>');
        
        // Basic styles for the print window to ensure it looks professional
        printWindow.document.write('<style>');
        printWindow.document.write('body { font-family: sans-serif; padding: 20px; color: black; background: white; }');
        printWindow.document.write('.card { border: 1px solid #000; margin-bottom: 20px; page-break-after: always; box-shadow: none; }');
        printWindow.document.write('.card:last-of-type { page-break-after: auto; }');
        printWindow.document.write('.table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }');
        printWindow.document.write('.table-bordered th, .table-bordered td { border: 1px solid #000 !important; padding: 5px !important; font-size: 9pt !important; }');
        printWindow.document.write('.bg-body-secondary { background-color: #f0f0f0 !important; -webkit-print-color-adjust: exact; }');
        printWindow.document.write('input, select { border: none !important; background: transparent !important; padding: 0 !important; font-size: 9pt !important; appearance: none; -webkit-appearance: none; width: 100%; }');
        printWindow.document.write('img { max-height: 50px; display: block; margin: 0 auto; }');
        printWindow.document.write('.no-print, .btn { display: none !important; }');
        printWindow.document.write('h2, h3 { font-size: 13pt; text-transform: uppercase; margin: 10px 0; font-weight: bold; }');
        printWindow.document.write('.text-uppercase { text-transform: uppercase; }');
        printWindow.document.write('.fw-bold { font-weight: bold; }');
        printWindow.document.write('.justify-content-center { display: flex; justify-content: center; align-items: center; }');
        printWindow.document.write('<\/style>');
        
        // Copy the Bootstrap 5 stylesheet for layout help - ESCAPED @@ for Razor
        printWindow.document.write('<link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">');
        
        printWindow.document.write('</head><body>');
        printWindow.document.write(printContents);
        printWindow.document.write('<\/body><\/html>');
        
        printWindow.document.close();
        
        // Wait for content (like fonts or Bootstrap) to potentially settle
        setTimeout(function() {
            printWindow.print();
            printWindow.close();
        }, 800);
    }


</script>